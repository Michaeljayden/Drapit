{% comment %}
  Drapit Virtual Try-On Button
  This block adds the Drapit widget to the product page.
{% endcomment %}

{%- liquid
  assign drapit_selected = product.selected_or_first_available_variant
  assign drapit_selected_img = drapit_selected.featured_image | default: product.featured_image
-%}

{%- capture drapit_variants -%}
[{%- for v in product.variants -%}
  {%- assign drapit_vimg = v.featured_image | default: product.featured_image -%}
  {"id":{{ v.id }},"img":{{ drapit_vimg | img_url: 'grande' | prepend: 'https:' | json }},"sku":{{ v.sku | json }}}
  {%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}]
{%- endcapture -%}

<script
  src="https://drapit.io/widget/drapit-widget.js"
  data-drapit-key="{{ block.settings.api_key }}"
  data-drapit-shop="{{ shop.permanent_domain }}"
  data-drapit-color="{{ block.settings.button_color }}"
  data-drapit-cta="{{ block.settings.button_text }}"
  data-drapit-lang="{{ block.settings.language | default: 'en' }}"
  data-drapit-outfits="{{ block.settings.enable_outfits }}"
  defer
></script>

<div class="drapit-product-container"
  data-drapit-product="https:{{ drapit_selected_img | img_url: 'grande' }}"
  data-drapit-product-id="{{ drapit_selected.sku | default: product.id }}"
  data-drapit-product-name="{{ product.title }}"
  data-drapit-buy-url="{{ shop.url }}{{ product.url }}"
  data-drapit-shopify-product-id="{{ product.id }}"
  data-drapit-product-handle="{{ product.handle }}"
  data-drapit-variant-id="{{ drapit_selected.id }}"
  data-drapit-variants="{{ drapit_variants | strip_newlines | escape }}"
></div>

{% schema %}
{
  "name": "Drapit Try-On",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "api_key",
      "label": "Drapit API Key (optioneel)",
      "info": "Laat dit leeg — de widget haalt de juiste sleutel automatisch op na installatie. Vul alleen handmatig een sleutel in als je daarom gevraagd wordt."
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#1D6FD8"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Virtual try-on",
      "info": "Leave as 'Virtual try-on' to show the default text in the widget language."
    },
    {
      "type": "select",
      "id": "language",
      "label": "Widget language",
      "options": [
        { "value": "en", "label": "English" },
        { "value": "nl", "label": "Nederlands" },
        { "value": "auto", "label": "Automatic (match store language)" }
      ],
      "default": "en"
    },
    {
      "type": "checkbox",
      "id": "enable_outfits",
      "label": "Combinaties aanbieden na een try-on",
      "info": "Toont na het resultaat 'Combineer met…' met een broek uit je shop. Een combinatie telt als 2 try-ons. Werkt alleen als Drapit dit voor je shop heeft ingeschakeld.",
      "default": false
    }
  ]
}
{% endschema %}
